# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grabbit_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars

# SMS (Twilio). Real sends when all three are set and SMS is enabled (default: enabled).
SMS_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: log OTP to console when using SMS mock (development only)
MOCK_OTP_LOG=true

# Database sync (Sequelize)
# In hosted environments, keep this false and run SQL migrations instead.
DB_SYNC_ALTER=false
