# Copy to .env.docker (or export) and adjust. Used by: docker compose --env-file .env.docker up --build

# API
API_PORT=3000
BASE_URL=http://localhost:3000

# Postgres (must match DATABASE_URL user/password in compose)
POSTGRES_PORT=5432
POSTGRES_PASSWORD=grabbit_dev_password

# Required for JWT — use long random strings in any shared environment
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

# Optional: sequelize.sync({ alter: true }) — use carefully
# DB_SYNC_ALTER=false

# SMS (Twilio) — optional; without these, OTP is logged only ([SMS MOCK])
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# SMS_ENABLED=true
